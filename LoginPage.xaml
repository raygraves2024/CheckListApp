< !--LoginPage.xaml-- >
< ContentPage xmlns = "http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns: x = "http://schemas.microsoft.com/winfx/2009/xaml"
             x: Class = "YourAppNamespace.LoginPage"
             Title = "Login" >
    < StackLayout Padding = "30" Spacing = "20" >
        < Label Text = "Login to Checklist App" FontSize = "Large" HorizontalOptions = "Center" />

        < !--Username Entry-- >
        < Entry x: Name = "UsernameEntry" Placeholder = "Username" />

        < !--Password Entry with Masked Input -->
        <Entry x:Name = "PasswordEntry" Placeholder = "Password" IsPassword = "True" />

        < !--Login Button-- >
        < Button Text = "Login" Clicked = "OnLoginButtonClicked" />

        < !--Label to display login status -->
        <Label x:Name = "StatusLabel" TextColor = "Red" IsVisible = "False" />
    </ StackLayout >
</ ContentPage >
