<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CheckListApp.View.TaskEntryPage"
             Title="Task Entry">

    <ScrollView>
        <Grid RowDefinitions="Auto,*,Auto" 
              Padding="20"
              RowSpacing="20">

            <!-- Header Section -->
            <VerticalStackLayout Grid.Row="0" 
                               Spacing="15">

                <!-- Title Entry -->
                <VerticalStackLayout>
                    <Label Text="Title"
                           FontSize="16"
                           TextColor="Gray"/>
                    <Entry x:Name="TaskTitleEntry"
                           Placeholder="Enter task title"
                           Text="{Binding Title}"/>
                </VerticalStackLayout>

                <!-- Description -->
                <VerticalStackLayout>
                    <Label Text="Description"
                           FontSize="16"
                           TextColor="Gray"/>
                    <Editor x:Name="TaskDescriptionEditor"
                            Placeholder="Enter task description"
                            Text="{Binding Description}"
                            AutoSize="TextChanges"
                            MaxLength="500"/>
                </VerticalStackLayout>

                <!-- Due Date -->
                <VerticalStackLayout>
                    <Label Text="Due Date"
                           FontSize="16"
                           TextColor="Gray"/>
                    <DatePicker x:Name="TaskDatePicker"
                              Date="{Binding DueDate}"
                              Format="D"/>
                </VerticalStackLayout>

                <!-- Priority -->
                <VerticalStackLayout>
                    <Label Text="Priority"
                           FontSize="16"
                           TextColor="Gray"/>
                    <Picker x:Name="PriorityPicker"
                            SelectedIndexChanged="OnPrioritySelected">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Low</x:String>
                                <x:String>Important</x:String>
                                <x:String>Urgent</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>

                <!-- Completed Status -->
                <HorizontalStackLayout>
                    <CheckBox x:Name="CompletedCheckBox"
                             IsChecked="{Binding IsCompleted}"/>
                    <Label Text="Mark as completed"
                           VerticalOptions="Center"
                           Margin="10,0,0,0"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Spacer -->
            <BoxView Grid.Row="1"/>

            <!-- Buttons Section -->
            <Grid Grid.Row="2" 
                  ColumnDefinitions="*,*" 
                  ColumnSpacing="20">

                <Button Grid.Column="0"
                        Text="Cancel"
                        BackgroundColor="Gray"
                        Clicked="OnCancelClicked"/>

                <Button Grid.Column="1"
                        x:Name="SaveButton"
                        Text="Add Task"
                        BackgroundColor="{StaticResource Primary}"
                        Clicked="OnSaveClicked"/>
            </Grid>

        </Grid>
    </ScrollView>
</ContentPage>