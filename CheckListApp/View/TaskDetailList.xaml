<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CheckListApp.View.TaskDetailList"
             Title="Task List">

    <CollectionView x:Name="TaskListView" ItemsSource="{Binding Tasks}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <SwipeView>
                    <!-- Swipe to Open Task -->
                    <SwipeView.RightItems>
                        <SwipeItem Text="Open"
                                   BackgroundColor="LightBlue"
                                   IconImageSource="open_icon.png"
                                   Invoked="OnOpenTaskSwipe"/>
                    </SwipeView.RightItems>

                    <!-- Task Item Layout with Details -->
                    <Grid Padding="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Task Title -->
                        <Label Text="{Binding Title}" 
                               FontSize="Medium" 
                               VerticalOptions="Center" />

                        <!-- Task Description -->
                        <Label Text="{Binding Description}"
                               FontSize="Small"
                               TextColor="Gray"
                               VerticalOptions="Start"
                               Grid.Row="1" />
                    </Grid>
                </SwipeView>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
