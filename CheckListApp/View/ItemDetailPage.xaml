<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CheckListApp.View.ItemDetailPage"
             Title="Item Detail Page">

    <ScrollView>
        <VerticalStackLayout Spacing="10" Margin="20">
            <!-- View Tasks Button -->
            <Button x:Name="ViewTasksButton"
                    Text="View Tasks"
                    Clicked="OnViewTasksClicked"
                    HorizontalOptions="End"
                    WidthRequest="120"
                    HeightRequest="40"
                    Margin="0,0,0,10"/>

            <!-- Task Detail Section -->
            <Frame x:Name="TaskDetailContent" IsVisible="true" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Task Title:" />
                    <Entry x:Name="TitleEntry" 
                           Placeholder="Enter task title" />

                    <Label Text="Description:" 
                       VerticalOptions="Center"
                       Margin="0,10,0,0"/>
                    <Editor x:Name="DescriptionEntry" 
                        Placeholder="Enter task description"
                        
                        AutoSize="TextChanges"
                        Margin="0,5,0,0"/>          

                    <Label Text="Priority:" />
                    <Picker x:Name="PriorityPicker"
                            Title="Select Priority">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Low</x:String>
                                <x:String>Important</x:String>
                                <x:String>Urgent</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <Label Text="Due Date:" />
                    <DatePicker x:Name="DueDatePicker" 
                              Format="D" />

                    <Button Text="Save" 
                            Clicked="OnSaveDataClicked"/>
                    
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>