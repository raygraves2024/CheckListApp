<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CheckListApp.View.ItemDetailPage"
             Title="Task Detail">

    <ScrollView>
        <VerticalStackLayout Spacing="10" Margin="20">
            <!-- View Tasks Button -->
            <Button x:Name="ViewTasksButton"
                    Text="View Tasks"
                    Clicked="OnViewTasksClicked"
                    HorizontalOptions="End"
                    WidthRequest="120"
                    HeightRequest="40"
                    Margin="0,0,0,10"/>

            <!-- Task Detail Section -->
            <Frame x:Name="TaskDetailContent" IsVisible="true" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Title:" />
                    <Entry x:Name="TitleEntry" 
                           Placeholder="Enter task title" />

                    <Label Text="Task:" />
                    <Entry x:Name="TaskEntry" 
                           Placeholder="Enter your task" />

                    <Label Text="Description:" />
                    <Editor x:Name="DescriptionEntry" 
                           Placeholder="Enter task description"
                           HeightRequest="100"
                           AutoSize="TextChanges"/>

                    <Label Text="Priority:" />
                    <Picker x:Name="PriorityPicker"
                            Title="Select Priority">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Low</x:String>
                                <x:String>Important</x:String>
                                <x:String>Urgent</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <Label Text="Due Date:" />
                    <DatePicker x:Name="DueDatePicker" 
                              Format="D" />

                    <Label x:Name="ResultLabel" 
                           Text="Saved Data will appear here." 
                           Margin="0,20,0,0"/>

                    <Button Text="Save" 
                            Clicked="OnSaveDataClicked"/>
                    <Button Text="Delete" 
                            BackgroundColor="Red" 
                            TextColor="White" 
                            Command="{Binding DeleteCommand}" />
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>